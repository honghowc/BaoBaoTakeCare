rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in ['honghowc@gmail.com', 'yfc1515@gmail.com'];
    }

    match /{document=**} {
      allow read, write: if isAllowed();
    }
  }
}
